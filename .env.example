# ============================================================
# NCC OD Form Generator - Environment Configuration
# ============================================================

# Base URL of the application (used to generate email verification links)
# In local development: http://localhost:3000
# In production: https://your-domain.com
APP_BASE_URL=http://localhost:3000

# Allowed CORS Origins (comma-separated list for Render backend)
ALLOWED_ORIGINS=https://ncc-od-form-generator-frontend.vercel.app,http://localhost:5173
PORT=3000

# ============================================================
# Development / Local Testing Mode
# Set to 'true' to display verification OTP on screen without sending real emails.
# Set to 'false' for live encrypted email delivery.
# ============================================================
DEV_OTP_MODE=false

# ============================================================
# SMTP Email Service Configuration (Secured SSL/TLS - Port 465)
# ============================================================
# Supported providers: Gmail, Outlook, Brevo, SendGrid, Amazon SES, or custom SMTP
#
# NOTE FOR GMAIL USERS:
# 1. Enable 2-Step Verification in your Google Account.
# 2. Generate an "App Password" at https://myaccount.google.com/apppasswords
# 3. Use your full Gmail address for SMTP_USER and the 16-character App Password for SMTP_PASS.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="NCC OD Portal" <your-email@gmail.com>

# Example for Outlook / Office 365:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@outlook.com
# SMTP_PASS=your-outlook-password
# SMTP_FROM="NCC OD Portal" <your-email@outlook.com>

# Example for Brevo (formerly Sendinblue):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-brevo-login
# SMTP_PASS=your-brevo-smtp-key
# SMTP_FROM="NCC OD Portal" <verified-sender@domain.com>

# ============================================================
# CadetAssist AI Voice Assistant (Optional)
# ============================================================
CADET_ASSIST_PROJECT_ID=p-3ce6a60b
CADET_ASSIST_API_KEY=

# ============================================================
# Google OAuth Sign-In (Optional)
# ============================================================
GOOGLE_CLIENT_ID=

